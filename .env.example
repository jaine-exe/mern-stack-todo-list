# Backend Server Configuration
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/mern_todo_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern_todo_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/mern_todo_db

# Allowed Frontend Origin (for CORS)
CLIENT_ORIGIN=http://localhost:3000
